{
  "name": "Asset Analyzer",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "user": "ubuntu",
  "install": "bash .cursor/cloud-agent-install.sh",
  "start": "bash .cursor/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "dev-server",
      "command": "set -a && source .env && set +a && npm run dev"
    },
    {
      "name": "ai-service",
      "command": "cd ai && .venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"
    }
  ],
  "ports": [
    {
      "name": "app",
      "port": 5000
    },
    {
      "name": "ai",
      "port": 8000
    }
  ]
}
